POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://seedream:replace-with-a-long-random-password@postgres:5432/seedream
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
API_KEY_PEPPER=replace-with-another-32-random-characters
SETUP_TOKEN=replace-with-a-one-time-setup-token-of-32-characters
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ARK_API_KEY=
SEEDREAM_ENDPOINT=https://ark.ap-southeast.bytepluses.com/api/v3/images/generations
SEEDREAM_MODEL=dola-seedream-5-0-pro-260628
SEEDREAM_FLASH_MODEL=dola-seedream-5-0-flash-260915
SEEDREAM_LITE_MODEL=seedream-5-0-lite-260128
SEEDREAM_SIZES=1K,1.5K,2K
SEEDREAM_DEFAULT_SIZE=2K
SEEDREAM_WATERMARK=false
PROVIDER_TIMEOUT_SECONDS=300
STORAGE_BACKEND=local
STORAGE_ROOT=/data/storage
MAX_UPLOAD_BYTES=31457280
RATE_LIMIT_PER_MINUTE=60
GENERATION_RATE_LIMIT_PER_MINUTE=10
# Optional APNs support. Leave blank when push notifications are not needed.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_B64=
APNS_TOPIC=com.example.seedream

